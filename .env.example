# ==============================================================================
# KONFIGURASI ENVIRONMENT VARIABLES (NEXT.JS & VERCEL)
# ==============================================================================

# 1. AMAN UNTUK KLIEN (PUBLIC)
# Variabel yang diawali dengan NEXT_PUBLIC_ akan disertakan dalam build
# klien (browser). Boleh terekspos karena dibatasi oleh RLS (Row Level Security).
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. RAHASIA SERVER (PRIVATE)
# Variabel TANPA awalan NEXT_PUBLIC_ TIDAK AKAN pernah dikirim ke browser.
# HANYA boleh diakses di Route Handlers (app/api/*) atau Server Actions.
# Jika bocor, peretas bisa mengambil alih database atau saldo secara penuh!

# Gunakan Service Role Key HANYA di backend (bypass segala rule RLS)
# untuk eksekusi logika kritis seperti pembagian komisi MLM atau update status Escrow.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ8..."

# API Key Pi Network untuk proses validasi transaksi dan payment
PI_API_KEY="pi_api_key_..."

# APP_URL: The URL where this applet is hosted.
# Digunakan untuk callback OAuth atau webhook.
APP_URL="MY_APP_URL"
